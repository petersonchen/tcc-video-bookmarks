{
  "manifest_version": 3,
  "name": "MPY Timecode Marker",
  "version": "0.2.0",
  "description": "Save, cue, and play timecode markers on supported video websites.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://live.tcc.gov.tw/*"],
  "action": {
    "default_title": "MPY Timecode Marker",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [{
    "matches": ["https://live.tcc.gov.tw/*"],
    "js": ["content/video-controller.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
